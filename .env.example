# Obligatoria para ingest / ask / eval / API
OPENAI_API_KEY=sk-...

# Modelos
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
EVAL_LLM_MODEL=gpt-4o-mini

# Qdrant (en docker-compose se sobreescribe con http://qdrant:6333)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=engineering_docs

# Recuperación
TOP_K=20
TOP_N=5
MIN_RERANK_SCORE=0.02
RERANKER_ENABLED=true

# Concurrencia (por worker)
WEB_CONCURRENCY=2
MAX_IN_FLIGHT_REQUESTS=64
LLM_CONCURRENCY=32
RERANK_CONCURRENCY=2
TORCH_THREADS=2

LOG_LEVEL=INFO
